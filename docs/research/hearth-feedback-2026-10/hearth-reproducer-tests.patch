@@ -0,0 +1,53 @@
+package hearth
+package examples
+package kindlingsfeedback
+
+// Test data for KindlingsFeedbackSpec: gaps found while porting kindlings macros (di / di-cats) to Hearth 0.4.3.
+
+// --- (1) generic method return type -------------------------------------------------------------------------------
+
+// Local stand-ins for cats-effect `Resource` / `Sync` / `SyncIO` (no cats dependency).
+trait Res[F[_], A]
+trait SyncLike[F[_]]
+trait SomeF[A]
+object SomeF {
+  implicit val syncLike: SyncLike[SomeF] = new SyncLike[SomeF] {}
+}
+final class Config
+
+final class Widget
+object Widget {
+  // type clause only, then nothing: `Widget.resource[SomeF]` is fully applied after `ApplyTypes`.
+  def resource[F[_]]: Res[F, Widget] = null
+}
+
+final class Service
+object Service {
+  // type clause, value clause, implicit (context-bound) clause.
+  @scala.annotation.nowarn
+  def resource[F[_]: SyncLike](config: Config): Res[F, Service] = null
+}
+
+final class Plain
+object Plain {
+  // NOT a `Res` - kindlings must be able to reject it by its (substituted) result type.
+  def resource[F[_]]: Option[Plain] = None
+}
+
+// --- (3) singleton types -------------------------------------------------------------------------------------------
+
+// covariant so that `Box[Int, String] <:< Box[Any, Any]` (used as a sanity check in the spec)
+final class Box[+A, +B](val a: A, val b: B)
+
+object SingletonVals {
+  val box: Box[Int, String] = new Box(1, "a")
+  val opt: Option[Int] = Some(1)
+  val str: String = "a"
+  val list: List[Int] = List(1)
+}
+
+// --- (7) Function1 subclass (not headed by `Function1` itself) -------------------------------------------------------
+
+class IntPredicate extends (Int => Boolean) {
+  def apply(i: Int): Boolean = i > 0
+}
diff --git a/hearth-tests/src/main/scala/hearth/typed/KindlingsFeedbackFixturesImpl.scala b/hearth-tests/src/main/scala/hearth/typed/KindlingsFeedbackFixturesImpl.scala
new file mode 100644
index 00000000..b9340b8f
--- /dev/null
+++ b/hearth-tests/src/main/scala/hearth/typed/KindlingsFeedbackFixturesImpl.scala
@@ -0,0 +1,232 @@
+package hearth
+package typed
+
+import hearth.data.Data
+import hearth.examples.kindlingsfeedback.*
+
+/** Fixtures for [[KindlingsFeedbackSpec]]: minimal reproducers of gaps found while porting kindlings macros to Hearth.
+  */
+trait KindlingsFeedbackFixturesImpl { this: MacroCommons =>
+
+  private def renderExpectations(m: Method): Data = Data.list(m.expectations.map {
+    case MethodExpectation.NeedsInstance   => Data("NeedsInstance")
+    case MethodExpectation.NeedsTypes(tps) =>
+      Data(tps.map(_.map(_.name).mkString(", ")).mkString("NeedsTypes[", "][", "]"))
+    case MethodExpectation.NeedsValues(ps) =>
+      Data(
+        ps.map(_.map { case (n, p) => s"$n: ${p.tpe.plainPrint}" }.mkString(", ")).mkString("NeedsValues(", ")(", ")")
+      )
+  }*)
+
+  private def stepName(m: Method): String = m match {
+    case _: Method.OnInstance  => "OnInstance"
+    case _: Method.ApplyTypes  => "ApplyTypes"
+    case _: Method.ApplyValues => "ApplyValues"
+    case _: Method.Result[?]   => "Result"
+  }
+
+  // `R` is the expected (substituted) return type: rendered as "=:= R" when it matches, so that the Scala 3 eta-expanded
+  // printing of the applied `F := SomeF` (`[A] => SomeF[A]`) does not obscure the comparison.
+  private def renderType[R: Type](t: ??): String =
+    if (t.Underlying =:= Type[R]) "=:= R" else t.plainPrint
+
+  private def renderStep[R: Type](m: Method): Data = Data.map(
+    "step" -> Data(stepName(m)),
+    "knownReturning" -> Data(m.knownReturning.map(renderType[R](_)).getOrElse("<none>")),
+    "expectations" -> renderExpectations(m)
+  )
+
+  // (1) Walk `A.methodName` (expected to return `R`) (a method of the companion object `A`) through the whole builder chain, applying
+  // `F := SomeF` at `ApplyTypes`, a `new Config` / summoned implicit at `ApplyValues`. Records every step.
+  def testGenericReturnWalk[A: Type, R: Type](instance: Expr[A])(methodName: Expr[String]): Expr[Data] =
+    genericReturnWalk[A, R](instance, methodName, viaCtor1Of = false)
+
+  // Same, but `F := SomeF` is passed as `Type.Ctor1.of[SomeF].asUntyped` (what kindlings does). On Scala 3 that is an
+  // eta-expanded type lambda, which is semantically equal but prints as `[A >: Nothing <: Any] => SomeF[A]`.
+  def testGenericReturnWalkViaCtor1Of[A: Type, R: Type](instance: Expr[A])(methodName: Expr[String]): Expr[Data] =
+    genericReturnWalk[A, R](instance, methodName, viaCtor1Of = true)
+
+  private def genericReturnWalk[A: Type, R: Type](
+      instance: Expr[A],
+      methodName: Expr[String],
+      viaCtor1Of: Boolean
+  ): Expr[Data] = {
+    val name = Expr.unapply(methodName).getOrElse(Environment.reportErrorAndAbort("method name must be a literal"))
+    val method = Type[A].methods.find(_.name == name).getOrElse(Environment.reportErrorAndAbort(s"no method $name"))
+    implicit val SomeFAny: Type[SomeF[Any]] = Type.of[SomeF[Any]]
+    val someF: ?? =
+      if (viaCtor1Of) Type.Ctor1.of[SomeF].asUntyped.as_??
+      else UntypedType.typeConstructor(UntypedType.fromTyped[SomeF[Any]]).as_??
+    implicit val ConfigType: Type[Config] = Type.of[Config]
+    implicit val StringType: Type[String] = Type.of[String]
+
+    val steps = scala.collection.mutable.ListBuffer.empty[Data]
+    @scala.annotation.tailrec
+    def loop(m: Method): Unit = {
+      steps += renderStep[R](m)
+      m match {
+        case oi: Method.OnInstance =>
+          loop(oi.apply(instance.asInstanceOf[Expr[oi.Instance]]))
+        case at: Method.ApplyTypes =>
+          loop(at.apply(at.typeParams.flatten.map(tp => tp -> someF).toMap))
+        case av: Method.ApplyValues =>
+          loop(av.apply(av.parameters.flatten.map { case (n, p) =>
+            import p.tpe.Underlying
+            val value: Expr_?? =
+              if (Underlying =:= Type.of[Config]) Expr.quote(new Config).as_??
+              else
+                Expr
+                  .summonImplicitByType(p.tpe.asUntyped)
+                  .map(UntypedExpr.as_??(_))
+                  .getOrElse(Environment.reportErrorAndAbort(s"cannot summon ${p.tpe.plainPrint}"))
+            n -> value
+          }.toMap))
+        case r: Method.Result[?] =>
+          import r.Returned
+          steps += Data.map(
+            "Result.Returned" -> Data(renderType[R](Type[r.Returned].as_??)),
+            // the danger: if `Returned` is `Nothing`, it conforms to ANY expected result type
+            "Returned <:< String" -> Data(Type[r.Returned] <:< Type.of[String]),
+            "built" -> Data(r.build() match {
+              case Right(e) => s"built: ${renderType[R](e.tpe.as_??)}"
+              case Left(e)  => s"FAILED: $e"
+            })
+          )
+      }
+    }
+    loop(method)
+    Expr(Data.list(steps.toList*))
+  }
+
+  // (3) singleton types
+  private def renderDecomposition[A: Type, B: Type](withPlainPrint: Boolean): Data = {
+    val untyped = UntypedType.fromTyped[A]
+    val printed =
+      if (withPlainPrint) List("plainPrint" -> Data(Type[A].plainPrint))
+      else Nil
+    val probes: List[(String, Data)] = List(
+      "decompose1" -> Data(Type.decompose1[A] match {
+        case Some((ctor, arg)) => s"Some((${ctor.asUntyped.plainPrint}, ${arg.plainPrint}))"
+        case None              => "None"
+      }),
+      "decompose2" -> Data(Type.decompose2[A] match {
+        case Some((ctor, (a1, a2))) => s"Some((${ctor.asUntyped.plainPrint}, ${a1.plainPrint}, ${a2.plainPrint}))"
+        case None                   => "None"
+      }),
+      "UntypedType.typeConstructor" -> Data(UntypedType.typeConstructor(untyped).plainPrint),
+      "UntypedType.typeArguments" -> Data(UntypedType.typeArguments(untyped).map(_.plainPrint).mkString("[", ", ", "]")),
+      "Type.typeArguments" -> Data(Type.typeArguments[A].map(_.plainPrint).mkString("[", ", ", "]")),
+      "hasSameTypeConstructor[A, B]" -> Data(Type.hasSameTypeConstructor[A, B]),
+      "Ctor2.of[Box].unapply" -> Data(Type.Ctor2.of[Box].unapply(Type[A]) match {
+        case Some((a1, a2)) => s"Some((${a1.plainPrint}, ${a2.plainPrint}))"
+        case None           => "None"
+      }),
+      "Ctor1.of[Option].unapply" -> Data(Type.Ctor1.of[Option].unapply(Type[A]) match {
+        case Some(a1) => s"Some(${a1.plainPrint})"
+        case None     => "None"
+      }),
+      "A <:< B" -> Data(Type[A] <:< Type[B])
+    )
+    Data.map((printed ++ probes)*)
+  }
+
+  def testDecompose[A: Type, B: Type]: Expr[Data] = Expr(renderDecomposition[A, B](withPlainPrint = true))
+
+  /** Same probes, but on the STATIC type of a user-provided argument expression (`Expr.typeOf`), which is how kindlings
+    * hit it: passing `SingletonVals.box` gives the singleton `SingletonVals.box.type` on Scala 3.
+    */
+  def testDecomposeExprType[B: Type](expr: Expr[Any]): Expr[Data] = {
+    val tpe: ?? = expr.tpe.as_??
+    import tpe.Underlying as A
+    // plainPrint omitted: Scala 2 already reports the WIDENED `Box[Int, String]` here, Scala 3 the singleton
+    // `SingletonVals.box.type` - only the decomposition results are compared.
+    Expr(renderDecomposition[A, B](withPlainPrint = false))
+  }
+
+  // (5) function / context-function classification
+  def testFunctionClassification[A: Type]: Expr[Data] = Expr(
+    Data.map(
+      "plainPrint" -> Data(Type[A].plainPrint),
+      "fqcn" -> Data(Type.fqcn[A]),
+      "fqcn.startsWith(scala.Function)" -> Data(Type.fqcn[A].startsWith("scala.Function")),
+      "Ctor2.of[Function1].unapply" -> Data(Type.Ctor2.of[Function1].unapply(Type[A]).isDefined),
+      "Ctor3.of[Function2].unapply" -> Data(Type.Ctor3.of[Function2].unapply(Type[A]).isDefined),
+      "<:< Function1[Nothing, Any]" -> Data(Type[A] <:< Type.of[Function1[Nothing, Any]])
+    )
+  )
+
+  // (6) `Type.fqcn` is not a type identity
+  def testFqcnIdentity[A: Type, B: Type]: Expr[Data] = Expr(
+    Data.map(
+      "fqcn[A]" -> Data(Type.fqcn[A]),
+      "fqcn[B]" -> Data(Type.fqcn[B]),
+      "fqcn[A] == fqcn[B]" -> Data(Type.fqcn[A] == Type.fqcn[B]),
+      "A =:= B" -> Data(Type[A] =:= Type[B])
+    )
+  )
+
+  // (7) `Type.Ctor2.of[Function1].unapply` - does it return `Nothing` for the (contravariant) first argument?
+  private def renderFunction1Unapply[A: Type](ctor: Type.Ctor2[Function1]): String =
+    ctor.unapply(Type[A]) match {
+      case Some((a1, a2)) => s"Some((${a1.plainPrint}, ${a2.plainPrint}))"
+      case None           => "None"
+    }
+
+  // Populated by `KindlingsFeedbackFunction1Extension` (a MacroExtension loaded through ServiceLoader, compiled in a
+  // different compilation unit) - the SPI path kindlings' docs claim needs `fromUntyped` wrapping.
+  var spiFunction1Ctor: Option[Type.Ctor2[Function1]] = None
+  def registerSpiFunction1Ctor(ctor: Type.Ctor2[Function1]): Unit = spiFunction1Ctor = Some(ctor)
+
+  def testFunction1Unapply[A: Type]: Expr[Data] = {
+    val sameUnit = Type.Ctor2.of[Function1]
+    val wrapped = Type.Ctor2.fromUntyped[Function1](sameUnit.asUntyped)
+    val otherUnit = KindlingsFeedbackOtherUnit.function1Ctor(this)
+    val loadResult = Environment.loadMacroExtensions[KindlingsFeedbackFunction1Extension]
+    val spi = spiFunction1Ctor
+    Expr(
+      Data.map(
+        "plainPrint" -> Data(Type[A].plainPrint),
+        "Ctor2.of[Function1] (same unit)" -> Data(renderFunction1Unapply[A](sameUnit)),
+        "Ctor2.fromUntyped(Ctor2.of[Function1].asUntyped)" -> Data(renderFunction1Unapply[A](wrapped)),
+        "Ctor2.of[Function1] (other compilation unit)" -> Data(renderFunction1Unapply[A](otherUnit)),
+        "Ctor2.of[Function1] (via MacroExtension SPI)" -> Data(spi match {
+          case Some(ctor) => renderFunction1Unapply[A](ctor)
+          case None       => s"<extension not loaded: ${loadResult.toEither.left.map(_.toVector.map(_.getMessage))}>"
+        })
+      )
+    )
+  }
+
+  // (4) parameters of the enclosing method (macwire uses them as wiring candidates)
+
+  /** What the PUBLIC 0.4.3 API exposes for the immediately-enclosing method: the `Enclosure.Method` fields. */
+  def testEnclosingMethodView: Expr[Data] = {
+    val rendered = enclosingScope.iterator.collectFirst { case m: Enclosure.Method =>
+      Data.map(
+        "name" -> Data(m.name),
+        // every field the case class has - there is no `parameters`
+        "fields" -> Data.list(m.productElementNames.toList.map(Data(_))*)
+      )
+    }
+    Expr(rendered.getOrElse(Data("<no enclosing method>")))
+  }
+
+  /** PROTOTYPE API (not in 0.4.3): value parameters of the immediately-enclosing method. */
+  def testEnclosingMethodParameters: Expr[Data] =
+    Expr(Data.list(Environment.enclosingMethodParameters.map(p => Data(s"${p.name}: ${p.tpe.plainPrint}"))*))
+
+  /** PROTOTYPE API: sum the enclosing method's `Int` parameters by USING their `ref`s in generated code. */
+  def testSumEnclosingIntParameters: Expr[Int] = {
+    implicit val IntType: Type[Int] = Type.of[Int]
+    val refs: List[Expr[Int]] = Environment.enclosingMethodParameters.collect {
+      case p if p.tpe.Underlying =:= Type.of[Int] => p.ref.value.asInstanceOf[Expr[Int]]
+    }
+    refs match {
+      case Nil          => Expr(0)
+      case head :: tail =>
+        tail.foldLeft(head) { (acc: Expr[Int], next: Expr[Int]) =>
+          Expr.quote(Expr.splice(acc) + Expr.splice(next))
+        }
+    }
+  }
+}
