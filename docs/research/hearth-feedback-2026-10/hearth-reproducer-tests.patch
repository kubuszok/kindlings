+package hearth
+package typed
+
+/** (7) A `Type.Ctor2.of[Function1]` created in a DIFFERENT compilation unit (file) than the fixture that unapplies it. */
+object KindlingsFeedbackOtherUnit {
+
+  def function1Ctor(ctx: MacroCommons): ctx.Type.Ctor2[Function1] = {
+    import ctx.*
+    Type.Ctor2.of[Function1]
+  }
+}
+
+/** (7) The same, but created inside a [[MacroExtension]] that is discovered through `ServiceLoader` (the
+  * `StandardMacroExtension` SPI path kindlings uses). Registered in `build.sbt` via `macroExtensionTraits`.
+  */
+abstract class KindlingsFeedbackFunction1Extension
+    extends MacroExtension[KindlingsFeedbackFixturesImpl & MacroCommons] {
+
+  def extend(ctx: KindlingsFeedbackFixturesImpl & MacroCommons): Unit = {
+    import ctx.*
+    ctx.registerSpiFunction1Ctor(Type.Ctor2.of[Function1])
+  }
+}
+
+final class KindlingsFeedbackFunction1ExtensionImpl extends KindlingsFeedbackFunction1Extension
