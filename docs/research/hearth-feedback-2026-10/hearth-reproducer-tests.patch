+  def testFqcnIdentity[A, B]: Data = macro KindlingsFeedbackFixtures.testFqcnIdentityImpl[A, B]
+  def testFunction1Unapply[A]: Data = macro KindlingsFeedbackFixtures.testFunction1UnapplyImpl[A]
+  def testEnclosingMethodView: Data = macro KindlingsFeedbackFixtures.testEnclosingMethodViewImpl
+  def testEnclosingMethodParameters: Data = macro KindlingsFeedbackFixtures.testEnclosingMethodParametersImpl
+  def testSumEnclosingIntParameters: Int = macro KindlingsFeedbackFixtures.testSumEnclosingIntParametersImpl
