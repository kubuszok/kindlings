diff --git a/hearth-tests/src/test/scala/hearth/typed/KindlingsFeedbackSpec.scala b/hearth-tests/src/test/scala/hearth/typed/KindlingsFeedbackSpec.scala
new file mode 100644
index 00000000..842f2708
--- /dev/null
+++ b/hearth-tests/src/test/scala/hearth/typed/KindlingsFeedbackSpec.scala
@@ -0,0 +1,269 @@
+package hearth
+package typed
+
+import hearth.data.Data
+import hearth.examples.kindlingsfeedback.*
+
+/** Minimal reproducers of gaps found while porting kindlings (di / di-cats / cats-derivation) macros to Hearth 0.4.3.
+  * Each group documents the EXPECTED (wanted) behavior; see `kindlings-feedback/<n>-*.md` for the write-ups.
+  */
+final class KindlingsFeedbackSpec extends MacroSuite {
+
+  // (4) macros expanded inside methods with parameters - plain methods (not test lambdas) to avoid `$anonfun` owners.
+  object ParamNest {
+
+    def view(a: Int, b: String)(implicit c: Long): Data = {
+      val local: Int = 1
+      val result: Data = KindlingsFeedbackFixtures.testEnclosingMethodView
+      val _ = (a, b, c, local)
+      result
+    }
+
+    def params(a: Int, b: String)(implicit c: Long): Data = {
+      val local: Int = 1
+      val result: Data = KindlingsFeedbackFixtures.testEnclosingMethodParameters
+      val _ = (a, b, c, local)
+      result
+    }
+
+    def genericParams[T](n: Int, s: String): Data = {
+      val result: Data = KindlingsFeedbackFixtures.testEnclosingMethodParameters
+      val _ = (n, s)
+      result
+    }
+
+    def sum(a: Int, b: Int, s: String): Int = {
+      val _ = s
+      KindlingsFeedbackFixtures.testSumEnclosingIntParameters
+    }
+  }
+
+  private val P = "hearth.examples.kindlingsfeedback"
+
+  group("(1) generic method: knownReturning after ApplyTypes") {
+
+    // `knownReturning`/`Returned` are rendered as "=:= R" when they are =:= the expected (substituted) return type R.
+
+    def step(name: String, knownReturning: String, expectations: String*): Data = Data.map(
+      "step" -> Data(name),
+      "knownReturning" -> Data(knownReturning),
+      "expectations" -> Data.list(expectations.map(Data(_))*)
+    )
+    val result: Data = Data.map(
+      "Result.Returned" -> Data("=:= R"),
+      "Returned <:< String" -> Data(false),
+      "built" -> Data("built: =:= R")
+    )
+
+    test("Widget.resource[F[_]]: Res[F, Widget] - Result.Returned is the substituted return type") {
+      KindlingsFeedbackFixtures.testGenericReturnWalk[Widget.type, Res[SomeF, Widget]](Widget)("resource") <==>
+        Data.list(
+          step("OnInstance", "<none>", "NeedsInstance", "NeedsTypes[F]"),
+          step("ApplyTypes", "<none>", "NeedsInstance", "NeedsTypes[F]"),
+          step("Result", "=:= R", "NeedsInstance", "NeedsTypes[F]"),
+          result
+        )
+    }
+
+    test("Plain.resource[F[_]]: Option[Plain] - Result.Returned must not be Nothing (it would pass any <:< check)") {
+      KindlingsFeedbackFixtures.testGenericReturnWalk[Plain.type, Option[Plain]](Plain)("resource") <==>
+        Data.list(
+          step("OnInstance", "<none>", "NeedsInstance", "NeedsTypes[F]"),
+          step("ApplyTypes", "<none>", "NeedsInstance", "NeedsTypes[F]"),
+          step("Result", "=:= R", "NeedsInstance", "NeedsTypes[F]"),
+          result
+        )
+    }
+
+    val serviceBefore = s"NeedsValues(config: $P.Config)(evidence$$1: $P.SyncLike[F])"
+    val serviceAfter = s"NeedsValues(config: $P.Config)(evidence$$1: $P.SyncLike[$P.SomeF])"
+
+    test("Service.resource[F[_]: SyncLike](config: Config): Res[F, Service] - known as soon as F is applied") {
+      KindlingsFeedbackFixtures.testGenericReturnWalk[Service.type, Res[SomeF, Service]](Service)("resource") <==>
+        Data.list(
+          step("OnInstance", "<none>", "NeedsInstance", "NeedsTypes[F]", serviceBefore),
+          step("ApplyTypes", "<none>", "NeedsInstance", "NeedsTypes[F]", serviceBefore),
+          // WANTED: the applied `F := SomeF` substituted into the return type, available right after ApplyTypes.
+          step("ApplyValues", "=:= R", "NeedsInstance", "NeedsTypes[F]", serviceAfter),
+          step("Result", "=:= R", "NeedsInstance", "NeedsTypes[F]", serviceAfter),
+          result
+        )
+    }
+
+    test("Service.resource with F passed as Type.Ctor1.of[SomeF].asUntyped (the kindlings way)") {
+      KindlingsFeedbackFixtures.testGenericReturnWalkViaCtor1Of[Service.type, Res[SomeF, Service]](Service)(
+        "resource"
+      ) <==>
+        Data.list(
+          step("OnInstance", "<none>", "NeedsInstance", "NeedsTypes[F]", serviceBefore),
+          step("ApplyTypes", "<none>", "NeedsInstance", "NeedsTypes[F]", serviceBefore),
+          step("ApplyValues", "=:= R", "NeedsInstance", "NeedsTypes[F]", serviceAfter),
+          step("Result", "=:= R", "NeedsInstance", "NeedsTypes[F]", serviceAfter),
+          result
+        )
+    }
+  }
+
+  group("(3) singleton types: decompose / typeConstructor / typeArguments / Ctor unapply") {
+
+    def expectedBox(plainPrint: String): Data = {
+      val printed: List[(String, Data)] = if (plainPrint.nonEmpty) List("plainPrint" -> Data(plainPrint)) else Nil
+      val probes: List[(String, Data)] = List(
+      "decompose1" -> Data("None"),
+      "decompose2" -> Data(s"Some(($P.Box, scala.Int, java.lang.String))"),
+      "UntypedType.typeConstructor" -> Data(s"$P.Box"),
+      "UntypedType.typeArguments" -> Data("[scala.Int, java.lang.String]"),
+      "Type.typeArguments" -> Data("[scala.Int, java.lang.String]"),
+      "hasSameTypeConstructor[A, B]" -> Data(true),
+      "Ctor2.of[Box].unapply" -> Data("Some((scala.Int, java.lang.String))"),
+      "Ctor1.of[Option].unapply" -> Data("None"),
+      "A <:< B" -> Data(true)
+      )
+      Data.map((printed ++ probes)*)
+    }
+
+    def expectedOpt(plainPrint: String): Data = Data.map(
+      "plainPrint" -> Data(plainPrint),
+      "decompose1" -> Data("Some((scala.Option, scala.Int))"),
+      "decompose2" -> Data("None"),
+      "UntypedType.typeConstructor" -> Data("scala.Option"),
+      "UntypedType.typeArguments" -> Data("[scala.Int]"),
+      "Type.typeArguments" -> Data("[scala.Int]"),
+      "hasSameTypeConstructor[A, B]" -> Data(true),
+      "Ctor2.of[Box].unapply" -> Data("None"),
+      "Ctor1.of[Option].unapply" -> Data("Some(scala.Int)"),
+      "A <:< B" -> Data(true)
+    )
+
+    test("baseline: declared type Box[Int, String]") {
+      KindlingsFeedbackFixtures.testDecompose[Box[Int, String], Box[Any, Any]] <==>
+        expectedBox(s"$P.Box[scala.Int, java.lang.String]")
+    }
+
+    test("singleton SingletonVals.box.type (explicit type argument)") {
+      KindlingsFeedbackFixtures.testDecompose[SingletonVals.box.type, Box[Any, Any]] <==>
+        expectedBox(s"$P.SingletonVals.box.type")
+    }
+
+    test("static type of the argument expression SingletonVals.box") {
+      // Scala 2 already reports the widened `Box[Int, String]` here, Scala 3 the singleton `SingletonVals.box.type`.
+      KindlingsFeedbackFixtures.testDecomposeExprType[Box[Any, Any]](SingletonVals.box) <==> expectedBox("")
+    }
+
+    test("baseline: declared type Option[Int]") {
+      KindlingsFeedbackFixtures.testDecompose[Option[Int], Option[Any]] <==> expectedOpt("scala.Option[scala.Int]")
+    }
+
+    test("singleton SingletonVals.opt.type (explicit type argument)") {
+      KindlingsFeedbackFixtures.testDecompose[SingletonVals.opt.type, Option[Any]] <==>
+        expectedOpt(s"$P.SingletonVals.opt.type")
+    }
+
+    test("singleton of a non-applied type (SingletonVals.str.type) still decomposes to None") {
+      KindlingsFeedbackFixtures.testDecompose[SingletonVals.str.type, String] <==> Data.map(
+        "plainPrint" -> Data(s"$P.SingletonVals.str.type"),
+        "decompose1" -> Data("None"),
+        "decompose2" -> Data("None"),
+        "UntypedType.typeConstructor" -> Data("java.lang.String"),
+        "UntypedType.typeArguments" -> Data("[]"),
+        "Type.typeArguments" -> Data("[]"),
+        "hasSameTypeConstructor[A, B]" -> Data(true),
+        "Ctor2.of[Box].unapply" -> Data("None"),
+        "Ctor1.of[Option].unapply" -> Data("None"),
+        "A <:< B" -> Data(true)
+      )
+    }
+  }
+
+  group("(5) function type classification") {
+
+    test("Int => String") {
+      KindlingsFeedbackFixtures.testFunctionClassification[Int => String] <==> Data.map(
+        "plainPrint" -> Data("scala.Function1[scala.Int, java.lang.String]"),
+        "fqcn" -> Data("scala.Function1"),
+        "fqcn.startsWith(scala.Function)" -> Data(true),
+        "Ctor2.of[Function1].unapply" -> Data(true),
+        "Ctor3.of[Function2].unapply" -> Data(false),
+        "<:< Function1[Nothing, Any]" -> Data(true)
+      )
+    }
+
+    test("IntPredicate extends (Int => Boolean): a function, but fqcn-based check misses it") {
+      KindlingsFeedbackFixtures.testFunctionClassification[IntPredicate] <==> Data.map(
+        "plainPrint" -> Data(s"$P.IntPredicate"),
+        "fqcn" -> Data(s"$P.IntPredicate"),
+        "fqcn.startsWith(scala.Function)" -> Data(false),
+        "Ctor2.of[Function1].unapply" -> Data(true),
+        "Ctor3.of[Function2].unapply" -> Data(false),
+        "<:< Function1[Nothing, Any]" -> Data(true)
+      )
+    }
+  }
+
+  group("(6) Type.fqcn is not a type identity") {
+
+    test("Box[Int, String] and Box[String, Int] share fqcn but are different types") {
+      KindlingsFeedbackFixtures.testFqcnIdentity[Box[Int, String], Box[String, Int]] <==> Data.map(
+        "fqcn[A]" -> Data(s"$P.Box"),
+        "fqcn[B]" -> Data(s"$P.Box"),
+        "fqcn[A] == fqcn[B]" -> Data(true),
+        "A =:= B" -> Data(false)
+      )
+    }
+  }
+
+  group("(7) Type.Ctor2.of[Function1].unapply") {
+
+    def expected(plainPrint: String, args: String): Data = Data.map(
+      "plainPrint" -> Data(plainPrint),
+      "Ctor2.of[Function1] (same unit)" -> Data(args),
+      "Ctor2.fromUntyped(Ctor2.of[Function1].asUntyped)" -> Data(args),
+      "Ctor2.of[Function1] (other compilation unit)" -> Data(args),
+      "Ctor2.of[Function1] (via MacroExtension SPI)" -> Data(args)
+    )
+
+    test("Int => Boolean") {
+      KindlingsFeedbackFixtures.testFunction1Unapply[Int => Boolean] <==>
+        expected("scala.Function1[scala.Int, scala.Boolean]", "Some((scala.Int, scala.Boolean))")
+    }
+
+    test("String => List[Int]") {
+      KindlingsFeedbackFixtures.testFunction1Unapply[String => List[Int]] <==>
+        expected(
+          "scala.Function1[java.lang.String, scala.collection.immutable.List[scala.Int]]",
+          "Some((java.lang.String, scala.collection.immutable.List[scala.Int]))"
+        )
+    }
+
+    test("IntPredicate extends (Int => Boolean) (subtype - not headed by Function1)") {
+      KindlingsFeedbackFixtures.testFunction1Unapply[IntPredicate] <==>
+        expected(s"$P.IntPredicate", "Some((scala.Int, scala.Boolean))")
+    }
+  }
+
+  group("(4) Enclosure.Method exposes no parameters of the enclosing method") {
+
+    test("0.4.3 public API: the enclosing method's view has localValues but no parameters") {
+      ParamNest.view(1, "x")(2L) <==> Data.map(
+        "name" -> Data("view"),
+        "fields" -> Data.list(Data("name"), Data("fullName"), Data("position"), Data("tpe"), Data("localValues"))
+      )
+    }
+
+    test("PROTOTYPE Environment.enclosingMethodParameters: all value clauses, incl. implicit") {
+      ParamNest.params(1, "x")(2L) <==> Data.list(
+        Data("a: scala.Int"),
+        Data("b: java.lang.String"),
+        Data("c: scala.Long")
+      )
+    }
+
+    test("PROTOTYPE Environment.enclosingMethodParameters: generic method, type params are not values") {
+      ParamNest.genericParams[String](1, "s") <==> Data.list(Data("n: scala.Int"), Data("s: java.lang.String"))
+    }
+
+    test("PROTOTYPE Environment.enclosingMethodParameters: refs are usable in generated code") {
+      ParamNest.sum(10, 32, "ignored") ==> 42
+    }
+  }
+}
