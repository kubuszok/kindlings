+  def testGenericReturnWalkImpl[A: c.WeakTypeTag, R: c.WeakTypeTag](instance: c.Expr[A])(methodName: c.Expr[String]): c.Expr[Data] =
+    testGenericReturnWalk[A, R](instance)(methodName)
