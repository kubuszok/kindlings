+    macro KindlingsFeedbackFixtures.testGenericReturnWalkImpl[A, R]
+  def testGenericReturnWalkViaCtor1Of[A, R](instance: A)(methodName: String): Data =
+    macro KindlingsFeedbackFixtures.testGenericReturnWalkViaCtor1OfImpl[A, R]
+  def testDecompose[A, B]: Data = macro KindlingsFeedbackFixtures.testDecomposeImpl[A, B]
